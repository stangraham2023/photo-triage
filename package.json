{
  "name": "photo-triage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "triage": "node --experimental-strip-types src/cli/index.ts",
    "fetch-model": "node scripts/fetch-model.mjs",
    "postinstall": "node scripts/fetch-model.mjs",
    "dev": "electron-vite dev",
    "build:app": "electron-vite build",
    "start": "electron-vite preview",
    "smoke": "electron-vite build && PHOTO_TRIAGE_SMOKE=1 electron ."
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "exiftool-vendored": "37.1.0",
    "libheif-js": "^1.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
